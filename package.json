{
	"name": "international-days-cs",
	"version": "2.0.0",
	"author": "Roman Ožana <roman@ozana.cz> (https://ozana.cz)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OzzyCzech/international-days-cs.git"
	},
	"license": "MIT",
	"description": "International and national days in Czech language",
	"keywords": [
		"czechia",
		"czech republic",
		"czech language",
		"international days",
		"mezinárodní dny",
		"národní dny"
	],
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"scripts": {
		"build": "pnpm run convert && pnpm run clean && tsc",
		"convert": "js-yaml data/international-days.yaml > lib/international-days.json",
		"test": "tsc --noEmit && vitest",
		"format": "biome check --write",
		"format:check": "biome check .",
		"lint": "biome lint",
		"clean": "rm -rf dist"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.24.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@ozzyczech/tsconfig": "^2.1.0",
		"@types/luxon": "^3.7.5",
		"@types/node": "^26.4.0",
		"js-yaml": "^5.4.1",
		"luxon": "^3.7.2",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
